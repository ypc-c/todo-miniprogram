<!-- pages/category/category.wxml -->
<view class="container">
  <view class="card">
    <view class="tip">内置分类不可删除，自定义分类可自由增删。</view>
    <view wx:for="{{categories}}" wx:key="id" class="cat-item">
      <view class="dot" style="background:{{item.color}}"></view>
      <text class="cat-name">{{item.name}}</text>
      <text wx:if="{{item.builtin}}" class="badge">内置</text>
      <text wx:else class="del" data-id="{{item.id}}" bindtap="del">删除</text>
    </view>
  </view>

  <view class="card">
    <text class="section-title">新增自定义分类</text>
    <input class="name-input" placeholder="分类名称" value="{{newName}}" bindinput="onName" maxlength="10" />
    <view class="color-row">
      <view
        wx:for="{{preset}}"
        wx:key="*this"
        class="color-dot {{color === item ? 'active' : ''}}"
        style="background:{{item}}"
        data-c="{{item}}"
        bindtap="selectColor"
      ></view>
    </view>
    <button class="btn-primary add-btn" bindtap="addCat">添加分类</button>
  </view>
</view>
