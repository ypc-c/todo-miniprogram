/* pages/category/category.wxss */
.tip {
  font-size: 24rpx;
  color: #9ca3af;
  margin-bottom: 16rpx;
}
.cat-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}
.dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}
.cat-name {
  flex: 1;
  font-size: 30rpx;
}
.badge {
  font-size: 22rpx;
  color: #9ca3af;
  background: #f1f5f9;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}
.del {
  font-size: 26rpx;
  color: #ef4444;
  padding: 0 10rpx;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.name-input {
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}
.color-row {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.color-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 4rpx solid transparent;
}
.color-dot.active {
  border-color: #1f2937;
}
.add-btn {
  width: 100%;
}
