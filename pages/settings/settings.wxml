<!-- pages/settings/settings.wxml -->
<view class="container">
  <view class="card stat">
    <text class="stat-num">{{taskCount}}</text>
    <text class="stat-label">条本地待办</text>
  </view>

  <view class="card menu">
    <view class="menu-item" bindtap="doExport">
      <text>导出我的数据</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goGuide">
      <text>如何添加到桌面</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="card about">
    <view class="about-title">关于</view>
    <text class="about-text">个人待办清单 · 纯本机存储，数据不上传云端，卸载小程序会清除数据，建议定期导出备份。</text>
  </view>
</view>
